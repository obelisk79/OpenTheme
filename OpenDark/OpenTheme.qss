* {
  padding: 0px;
  margin: 0px;
  border: 0px solid transparent;
  border-radius: @CornerRadius;
  border-image: none;
  outline: 0;
  background-color: @SurfaceBase;
  dialogbuttonbox-buttons-have-icons: 0; }

QAbstractSpinBox, QSpinBox {
  margin: 0px;
  padding: 3px 2px 2px 2px;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
  padding-left: 6px;
  text-align: left; }
  QAbstractSpinBox::up-button, QSpinBox::up-button {
    width: 12px;
    subcontrol-origin: border;
    subcontrol-position: top right;
    top: 1px;
    right: 1px;
    border-radius: 0px;
    border-top-right-radius: @CornerRadius; }
  QAbstractSpinBox::down-button, QSpinBox::down-button {
    width: 12px;
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    bottom: 1px;
    right: 1px;
    border-radius: 0px;
    border-bottom-right-radius: @CornerRadius; }
  QAbstractSpinBox::up-arrow, QSpinBox::up-arrow {
    top: 1px; }
  QAbstractSpinBox::down-arrow, QSpinBox::down-arrow {
    top: 1px; }

Gui--QuantitySpinBox,
Gui--IntSpinBox,
Gui--UIntSpinBox,
Gui--DoubleSpinBox {
  padding-top: 1px;
  padding-bottom: 0px; }

QAbstractSpinBox > QLineEdit, QSpinBox > QLineEdit {
  padding: 0px;
  margin: 0px; }

QCheckBox {
  margin: 0px;
  padding: 0px;
  margin: 2px; }
  QCheckBox::indicator {
    top: 1px;
    padding: 1px;
    width: 12px;
    height: 12px; }
    QCheckBox::indicator:checked {
      width: 12px;
      height: 12px; }

QComboBox, Gui--WorkbenchComboBox {
  margin: 0px;
  padding: 4px 2px;
  padding-left: 8px; }
  QComboBox::drop-down, Gui--WorkbenchComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: @CornerRadius;
    border-bottom-right-radius: @CornerRadius; }

QDockWidget {
  margin: 0px;
  padding: 0px; }
  QDockWidget::title {
    margin: 0px;
    padding: 0px;
    text-align: center; }

QDockWidget::title QToolButton, QDockWidget::title QWidget#Selector > QToolButton {
  margin: 1px; }

QDialog {
  margin: 0px;
  padding: 0px;
  dialogbuttonbox-buttons-have-icons: 0; }

QGroupBox {
  font-weight: bold;
  margin-top: 1.5ex;
  padding-top: 10px; }
  QGroupBox::title {
    subcontrol-position: top left;
    top: -8px;
    padding-right: 12px; }
  QGroupBox::indicator {
    width: 12px;
    height: 12px;
    left: 6px;
    margin-top: 4px;
    border-radius: @CornerRadius; }

QHeaderView::section {
  border-top: none;
  border-bottom: none;
  padding: 4px;
  padding-left: 12px; }

QLabel {
  text-align: right;
  margin: 0px;
  padding: 0px; }
  QLabel::label {
    subcontrol-origin: center right; }

QLineEdit {
  margin: 0px;
  padding: 4px 6px;
  min-height: 16px; }

Qlist {
  padding: 0px 8px 0px 8px; }
  Qlist::indicator {
    width: 12px;
    height: 12px;
    padding: 2px;
    border-radius: 6px; }
  Qlist::item {
    margin: 0px 0px;
    padding: 0px 3px;
    font-weight: 700;
    font-size: 24px; }

QMainWindow {
  margin: 0px;
  padding: 0px;
  border: @BorderWidth solid transparent;
  border-radius: @CornerRadius; }
  QMainWindow::separator:vertical {
    width: 4px; }

QMdiSubWindow {
  border: @BorderWidth solid transparent; }

QMenu {
  border-radius: 0px; }
  QMenu::item {
    padding: 4px;
    padding-left: 10px;
    padding-right: 28px; }
  QMenu::icon {
    left: 6px; }
  QMenu::indicator {
    width: 12px;
    height: 12px;
    left: 6px;
    border-radius: @CornerRadius; }
  QMenu::right-arrow {
    right: 8px; }
  QMenu::separator {
    height: 1px;
    margin: 0px 10px; }

QMenuBar {
  padding: 3px 0px;
  spacing: 2px; }
  QMenuBar::item {
    padding: 3px 6px; }
  QMenuBar::item:pressed {
    border-radius: @CornerRadius; }
  QMenuBar::item:selected {
    border-radius: @CornerRadius; }

QProgressBar {
  min-height: 24px;
  text-align: center;
  padding: 1px;
  border-radius: 1px; }
  QProgressBar::chunk {
    border-radius: 1px; }

QPushButton, #WbTabBar > QTabBar #ScrollLeftButton, #WbTabBar > QTabBar #ScrollRightButton, QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton, QWidget#wbList QPushButton, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton {
  padding: 5px 10px; }

QRadioButton {
  margin: 0px;
  padding: 0px;
  margin: 2px; }
  QRadioButton::indicator {
    top: 1px;
    height: 13px;
    width: 13px;
    border-radius: 7px; }

QScrollBar {
  margin: 0px; }
  QScrollBar::handle {
    border-radius: 3px; }
    QScrollBar::handle:vertical {
      margin: 16px 3px;
      min-height: 12px; }
    QScrollBar::handle:horizontal {
      margin: 3px 16px;
      min-width: 8px; }
  QScrollBar::sub-line:vertical {
    margin: 3px 0px 3px 1px;
    /* 1px to correctly fit the 10px width image */
    height: 6px;
    width: 10px;
    subcontrol-position: top;
    subcontrol-origin: margin; }
  QScrollBar::sub-line:horizontal:horizontal {
    margin: 0px 3px 0px 3px;
    /* 1px to correctly fit the 10px width image */
    width: 10px;
    height: 7px;
    subcontrol-position: left;
    subcontrol-origin: margin; }
  QScrollBar::add-line:vertical {
    margin: 3px 0px 3px 1px;
    /* 1px to correctly fit the 10px width image */
    height: 6px;
    width: 10px;
    subcontrol-position: bottom;
    subcontrol-origin: margin; }
  QScrollBar::add-line:horizontal {
    margin: 0px 3px 0px 3px;
    /* 1px to correctly fit the 10px width image */
    width: 10px;
    height: 7px;
    subcontrol-position: right;
    subcontrol-origin: margin; }

QSizeGrip {
  width: 12px;
  height: 12px; }

QTabBar {
  margin: 4px;
  qproperty-drawBase: 0; }
  QTabBar::tab {
    margin: 4px;
    padding: 4px;
    padding-left: 12px;
    padding-right: 12px;
    min-width: 16px;
    border-radius: @CornerRadiusLarge; }
    QTabBar::tab:left, QTabBar::tab:right {
      padding-left: 4px;
      padding-right: 4px;
      padding-bottom: 12px;
      padding-top: 12px;
      min-width: 24px;
      min-height: 24px; }
  QTabBar::close-button {
    margin-right: 6px;
    subcontrol-origin: margin;
    subcontrol-position: center right;
    background-position: center center;
    background-repeat: none; }
  QTabBar::scroller {
    width: 52px;
    margin: 7px 0px 7px 3px; }

QTreeView {
  show-decoration-selected: 0;
  padding: 0px 8px 0px 8px;
  qproperty-indentation: 20; }
  QTreeView::indicator {
    width: 9px;
    height: 9px;
    padding: 2px;
    border-radius: 6px; }
  QTreeView::item {
    margin: 0px 0px;
    padding: 0px; }

QTreeView QLineEdit {
  padding: 0px;
  margin: 0px; }

QToolBar {
  padding: 2px;
  border-radius: 0px; }
  QToolBar * {
    margin: 0;
    padding: 0; }
  QToolBar QTabBar::tab {
    padding-top: 6px; }
  QToolBar QPushButton, QToolBar #WbTabBar > QTabBar #ScrollLeftButton, #WbTabBar > QTabBar QToolBar #ScrollLeftButton, QToolBar #WbTabBar > QTabBar #ScrollRightButton, #WbTabBar > QTabBar QToolBar #ScrollRightButton, QToolBar QSint--ActionGroup QFrame[class="content"] QToolButton, QToolBar QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton, QSint--ActionGroup QFrame[class="content"] QToolBar QToolButton, QSint--ActionGroup QFrame[class="content"] QToolBar QWidget#Selector > QToolButton, QToolBar QWidget#wbList QPushButton, QToolBar QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QToolBar QWidget#wbList QToolButton, QWidget#wbList QToolBar QPushButton, QWidget#wbList QToolBar QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolBar QToolButton {
    padding: 3px; }
  QToolBar::separator:vertical {
    height: 1px;
    margin: 4px 6px; }
  QToolBar::separator:horizontal {
    width: 1px;
    margin: 6px 4px; }

QStatusBar QToolBar, QMenuBar QToolBar {
  background-color: transparent;
  border-bottom: none; }

Gui--ToolBarAreaWidget {
  background-color: transparent; }

QToolButton, QWidget#Selector > QToolButton {
  margin: 0px 1px 0px 1px;
  padding: 2px;
  border-radius: @CornerRadiusLarge; }
  QToolButton:hover, QWidget#Selector > QToolButton:hover, QToolButton:focus, QWidget#Selector > QToolButton:focus, QToolButton:pressed, QWidget#Selector > QToolButton:pressed {
    margin: 0px 1px 0px 1px; }
  QToolButton::menu-button, QWidget#Selector > QToolButton::menu-button {
    border-radius: @CornerRadius;
    height: 2.0ex;
    width: 2.0ex;
    padding: 0px;
    border-radius: @CornerRadius;
    subcontrol-origin: padding;
    subcontrol-position: right bottom; }
  QToolButton::menu-arrow, QWidget#Selector > QToolButton::menu-arrow {
    width: 1.5ex;
    height: 1.5ex;
    subcontrol-origin: content;
    subcontrol-position: center center; }
  QToolButton::menu-indicator, QWidget#Selector > QToolButton::menu-indicator {
    /* Exclude a shift for better image */
    subcontrol-origin: padding;
    /* Shift it a bit */ }

QToolButton#qt_toolbar_ext_button, QWidget#Selector > QToolButton#qt_toolbar_ext_button {
  margin: 0px;
  padding: 0px;
  margin-top: 5px;
  margin-bottom: 5px;
  min-width: 10px; }

QToolBar > QToolButton#qt_toolbutton_menubutton {
  padding-right: 4px; }
  QToolBar > QToolButton#qt_toolbutton_menubutton::menu-button {
    subcontrol-origin: margin; }
  QToolBar > QToolButton#qt_toolbutton_menubutton::menu-indicator {
    subcontrol-position: right bottom; }

QToolTip {
  padding: 4px; }

QDialog#Gui__Dialog__DlgPreferences QGroupBox {
  border-bottom: 0px; }

QDialog#Gui__Dialog__DlgPreferences QListView {
  min-width: 120px; }

QDialog#Gui__Dialog__DlgPreferences QTreeView#groupsTreeView {
  show-decoration-selected: 1; }
  QDialog#Gui__Dialog__DlgPreferences QTreeView#groupsTreeView::item {
    border: none;
    border-radius: 0;
    background-color: transparent; }
    QDialog#Gui__Dialog__DlgPreferences QTreeView#groupsTreeView::item:selected {
      border: none; }

QToolBar > Gui--WorkbenchComboBox QAbstractItemView {
  min-width: 180px; }

/*==================================================================================================
Tasks panel (custom FreeCAD class)
==================================================================================================*/
/* Panel header */
QSint--ActionGroup QFrame[class="header"] {
  margin: 0px;
  padding: 0px; }

QSint--ActionGroup QToolButton[class="header"], QSint--ActionGroup QWidget#Selector > QToolButton[class="header"] {
  text-align: left;
  font-weight: bold;
  margin: 0px;
  padding: 0px; }

QSint--ActionGroup QFrame[class="header"] QLabel {
  background-repeat: none;
  background-position: center center;
  padding: 0px;
  margin: 0px; }

QSint--ActionGroup QFrame[class="header"] QLabel[fold="true"] {
  background-repeat: none;
  background-position: center center;
  padding: 0px;
  margin: 0px; }

QSint--ActionGroup QFrame[class="content"] QGroupBox > QCheckBox {
  subcontrol-origin: border;
  subcontrol-position: center left; }

QSint--ActionGroup QFrame[class="content"] QTreeView QAbstractSpinBox, QSint--ActionGroup QFrame[class="content"] QTreeView QSpinBox {
  margin: 0px;
  padding: 0px 0px 1px 0px; }

QDialog#Gui__Dialog__DlgPreferences QComboBox, QDialog#Gui__Dialog__DlgPreferences Gui--WorkbenchComboBox {
  max-height: 22px; }

/* Cells with values that can only be changed with "..." button (Attachment)
/* These seem to draw on top of the underlying label, so must be completely hidden or have an opaque background */
Gui--PropertyEditor--PropertyEditor > QWidget > QWidget > QLabel {
  margin-left: 1px;
  max-height: 20px; }

Gui--PropertyEditor--PropertyEditor QWidget {
  margin: 0px;
  padding: 0px;
  border: 0px solid transparent;
  border-right: @BorderWidth solid @ViewGridLines;
  border-bottom: @BorderWidth solid @ViewGridLines;
  border-radius: 0px;
  min-height: 0px; }

Gui--PropertyEditor--PropertyEditor QLineEdit > QWidget {
  margin-top: 3px; }

QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton {
  padding: 4px 10px 3px 10px; }

QTabWidget#TabBar > QTabBar::tab:top,
QTabWidget#TabBar > QTabBar::tab:bottom {
  margin: 0px 2px 4px 2px;
  min-width: -1; }

QWidget#Tabs {
  margin: 0px;
  margin-left: 6px;
  padding-top: 0px; }

QWidget#Selector > QToolButton {
  max-height: 24px; }

SpreadsheetGui--SheetTableView {
  qproperty-alternatingRowColors: true; }

SpreadsheetGui--SheetTableView QLineEdit {
  min-width: 186px; }

/**
 * Special handling for WB Tab Bar
 */
#WbTabBar #WbTabBarMore {
  margin: 0;
  padding: 5px 8px;
  margin-top: 1px;
  padding-top: 4px;
  border-radius: @CornerRadiusLarge; }

#WbTabBar > QTabBar {
  background-color: transparent;
  qproperty-drawBase: 0; }
  #WbTabBar > QTabBar::tab:left, #WbTabBar > QTabBar::tab:right {
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 12px;
    padding-top: 12px;
    min-height: 2em;
    min-width: 24px; }
  #WbTabBar > QTabBar[style="icon-only"]::tab {
    min-width: 16px;
    min-height: 16px; }
    #WbTabBar > QTabBar[style="icon-only"]::tab:top, #WbTabBar > QTabBar[style="icon-only"]::tab:bottom {
      padding-right: 0; }
    #WbTabBar > QTabBar[style="icon-only"]::tab:left, #WbTabBar > QTabBar[style="icon-only"]::tab:right {
      padding-top: 0; }

#ScrollLeftButton,
#ScrollRightButton {
  margin: 7px 0px 7px 3px;
  max-height: 22px; }

#fcSymbolDir,
#fcFile {
  max-height: 26px; }

QAbstractSpinBox::up-arrow, QSpinBox::up-arrow {
  image: url(qss:opentheme_images/up_arrow_@IconVariant.svg); }
  QAbstractSpinBox::up-arrow:disabled, QSpinBox::up-arrow:disabled {
    image: url(qss:opentheme_images/up_arrow_disabled_@IconVariant.svg); }

QAbstractSpinBox::down-arrow, QSpinBox::down-arrow {
  image: url(qss:opentheme_images/down_arrow_@IconVariant.svg); }
  QAbstractSpinBox::down-arrow:disabled, QSpinBox::down-arrow:disabled {
    image: url(qss:opentheme_images/down_arrow_disabled_@IconVariant.svg); }

QCheckBox::indicator:checked {
  image: url(qss:opentheme_images/check_@IconVariant.svg); }

QComboBox::down-arrow, Gui--WorkbenchComboBox::down-arrow {
  image: url(qss:opentheme_images/down_arrow_@IconVariant.svg); }
  QComboBox::down-arrow:disabled, Gui--WorkbenchComboBox::down-arrow:disabled {
    image: url(qss:opentheme_images/down_arrow_disabled_@IconVariant.svg); }

QGroupBox::indicator:checked {
  image: url(qss:opentheme_images/check_@IconVariant.svg); }

QList::indicator:checked, QTreeView::indicator:checked, QTree::indicator:checked, QListView::indicator:checked {
  image: url(qss:opentheme_images/check_@IconVariant.svg); }
  QList::indicator:checked:disabled, QTreeView::indicator:checked:disabled, QTree::indicator:checked:disabled, QListView::indicator:checked:disabled {
    image: url(qss:opentheme_images/check_disabled_@IconVariant.svg); }

QMenu::indicator:checked {
  image: url(qss:opentheme_images/check_@IconVariant.svg); }

QRadioButton::indicator:checked {
  image: url(qss:opentheme_images/radiobutton_@IconVariant.svg); }

QScrollBar::sub-line:vertical {
  border-image: url(qss:opentheme_images/up_arrow_@IconVariant.svg); }

QScrollBar::sub-line:horizontal:horizontal {
  border-image: url(qss:opentheme_images/left_arrow_@IconVariant.svg); }

QScrollBar::add-line:vertical {
  border-image: url(qss:opentheme_images/down_arrow_@IconVariant.svg); }

QScrollBar::add-line:horizontal {
  border-image: url(qss:opentheme_images/right_arrow_@IconVariant.svg); }

QSizeGrip {
  image: url(qss:opentheme_images/sizegrip_@IconVariant.svg); }

QTreeView::branch {
  background: transparent; }

QTreeView::branch:has-siblings:!adjoins-item {
  border-image: url(qss:opentheme_images/branch_line_@IconVariant.svg) 0 repeat; }

QTreeView::branch:has-siblings:adjoins-item {
  border-image: url(qss:opentheme_images/branch_line_@IconVariant.svg) 0 repeat;
  image: url(qss:opentheme_images/branch_stub_@IconVariant.svg) 0; }

QTreeView::branch:!has-children:!has-siblings:adjoins-item {
  border-image: none;
  image: url(qss:opentheme_images/branch_corner_@IconVariant.svg) 0; }

QTreeView#groupsTreeView::branch:has-siblings:!adjoins-item,
QTreeView#groupsTreeView::branch:!has-children:has-siblings:adjoins-item,
QTreeView#groupsTreeView::branch:!has-children:!has-siblings:adjoins-item,
Gui--PropertyEditor--PropertyEditor::branch:has-siblings:!adjoins-item,
Gui--PropertyEditor--PropertyEditor::branch:!has-children:has-siblings:adjoins-item,
Gui--PropertyEditor--PropertyEditor::branch:!has-children:!has-siblings:adjoins-item {
  border-image: none;
  image: none; }

QTreeView::branch:closed:has-children:has-siblings {
  border-image: none;
  image: url(qss:opentheme_images/branch_more_closed_@IconVariant.svg) 0; }

QTreeView::branch:has-children:!has-siblings:closed {
  border-image: none;
  image: url(qss:opentheme_images/branch_end_closed_@IconVariant.svg) 0; }

QTreeView::branch:open:has-children:has-siblings {
  border-image: none;
  image: url(qss:opentheme_images/branch_more_open_@IconVariant.svg) 0; }

QTreeView::branch:open:has-children:!has-siblings {
  border-image: none;
  image: url(qss:opentheme_images/branch_end_open_@IconVariant.svg) 0; }

QToolBarExtension {
  qproperty-icon: url(qss:opentheme_images/expand_@IconVariant.svg); }

QToolButton::menu-arrow, QWidget#Selector > QToolButton::menu-arrow {
  image: url(qss:opentheme_images/more_arrow_@IconVariant.svg); }

QSint--ActionGroup QFrame[class="header"] QLabel {
  background-image: url(qss:opentheme_images/down_arrow_@IconVariant.svg); }

QSint--ActionGroup QFrame[class="header"] QLabel[fold="true"] {
  background-image: url(qss:opentheme_images/up_arrow_@IconVariant.svg); }

QTabBar::close-button {
  image: url(qss:opentheme_images/obtn_close_@IconVariant.svg); }
  QTabBar::close-button:hover {
    image: url(qss:opentheme_images/obtn_closehover_@IconVariant.svg); }
  QTabBar::close-button:selected {
    image: url(qss:opentheme_images/obtn_closehover_@IconVariantOnAccent.svg); }

Gui--OverlayToolButton {
  image: url(qss:opentheme_images/obtn_close_@IconVariant.svg); }
  Gui--OverlayToolButton:hover {
    image: url(qss:opentheme_images/obtn_closehover_@IconVariant.svg); }

Gui--OverlayToolButton[objectName="OBTN Transparent"] {
  image: url(qss:opentheme_images/obtn_transparent_@IconVariant.svg); }
  Gui--OverlayToolButton[objectName="OBTN Transparent"]:hover {
    image: url(qss:opentheme_images/obtn_transparenthover_@IconVariant.svg); }

Gui--OverlayToolButton[objectName="OBTN Overlay"] {
  image: url(qss:opentheme_images/obtn_overlay_@IconVariant.svg); }
  Gui--OverlayToolButton[objectName="OBTN Overlay"]:hover {
    image: url(qss:opentheme_images/obtn_overlayhover_@IconVariant.svg); }

Gui--OverlayToolButton[objectName="OBTN AutoMode"] {
  image: url(qss:opentheme_images/obtn_mode_@IconVariant.svg); }
  Gui--OverlayToolButton[objectName="OBTN AutoMode"]:hover {
    image: url(qss:opentheme_images/obtn_modehover_@IconVariant.svg); }

Gui--OverlaySplitterHandle Gui--OverlayToolButton,
Gui--OverlayToolButton[objectName="OBTN Float"] {
  image: url(qss:opentheme_images/obtn_float_@IconVariant.svg); }
  Gui--OverlaySplitterHandle Gui--OverlayToolButton:hover,
  Gui--OverlayToolButton[objectName="OBTN Float"]:hover {
