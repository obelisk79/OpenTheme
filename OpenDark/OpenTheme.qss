QToolButton#buttonPauseUpdate, QWidget#Selector > QToolButton#buttonPauseUpdate {
  qproperty-icon: url(qss:opentheme_images/stop.png); }

QTreeView::branch#groupsTreeView:closed:has-children:has-siblings {
  border-image: none 0; }

QTreeView::branch#groupsTreeView:open:has-children:has-siblings {
  border-image: none 0; }

QTreeView::branch#groupsTreeView:open:has-children:!has-siblings {
  border-image: none 0; }

QTreeView::branch#groupsTreeView:has-children:!has-siblings:closed {
  border-image: none 0; }

QTreeView::branch#groupsTreeView:has-siblings:!adjoins-item {
  border-image: none 0; }

QTableView::indicator:checked {
  image: url(qss:opentheme_images/check_@IconVariant.svg); }

QTableView::indicator:checked:disabled {
  image: url(qss:opentheme_images/check_disabled_@IconVariant.svg); }

QAbstractSpinBox, QSpinBox {
  color: @TextPrimary;
  background-color: @FieldBackground;
  border: @BorderWidth solid @FieldBorder;
  border-radius: @CornerRadius; }
  QAbstractSpinBox:focus, QSpinBox:focus {
    border-color: @BorderFocus; }
  QAbstractSpinBox:hover, QSpinBox:hover {
    border-color: @BorderHover; }
  QAbstractSpinBox:disabled, QSpinBox:disabled {
    color: @TextDisabled;
    border-color: @BorderDisabled; }
  QAbstractSpinBox::up-button, QSpinBox::up-button {
    background-color: transparent;
    border: @BorderWidth solid transparent;
    border-right: 3px solid transparent; }
    QAbstractSpinBox::up-button:disabled, QSpinBox::up-button:disabled {
      background-color: @SurfaceDisabled; }
  QAbstractSpinBox::down-button, QSpinBox::down-button {
    background-color: transparent;
    border: @BorderWidth solid transparent;
    border-right: 3px solid transparent; }
    QAbstractSpinBox::down-button:disabled, QSpinBox::down-button:disabled {
      background-color: @SurfaceDisabled; }

QCheckBox {
  color: @TextPrimary;
  background: transparent; }
  QCheckBox:disabled {
    color: @TextDisabled; }
  QCheckBox::indicator {
    color: @TextPrimary;
    background-color: @FieldBackground;
    border: @BorderWidth solid @IndicatorBorder;
    border-radius: @CornerRadius; }
    QCheckBox::indicator:focus {
      border-color: @BorderFocus; }
    QCheckBox::indicator:disabled {
      background-color: @SurfaceDisabled; }
    QCheckBox::indicator:hover {
      border: @BorderWidth solid @BorderHover; }

QComboBox, Gui--WorkbenchComboBox {
  color: @TextPrimary;
  background-color: @FieldBackground;
  border: @BorderWidth solid @FieldBorder;
  border-radius: @CornerRadius;
  selection-background-color: @SurfaceHover; }
  QComboBox:focus, Gui--WorkbenchComboBox:focus {
    border-color: @BorderFocus; }
  QComboBox:disabled, Gui--WorkbenchComboBox:disabled {
    color: @TextDisabled; }
  QComboBox:hover, Gui--WorkbenchComboBox:hover {
    border-color: @BorderHover; }
  QComboBox::drop-down, Gui--WorkbenchComboBox::drop-down {
    background-color: transparent;
    border: 2px solid transparent;
    border-right: 5px solid transparent; }
    QComboBox::drop-down:disabled, Gui--WorkbenchComboBox::drop-down:disabled {
      background-color: @SurfaceDisabled; }

QDockWidget {
  color: @TextPrimary;
  background: @SurfaceBase;
  border: @BorderWidth solid @BorderStrong;
  border-radius: @CornerRadius; }

QDialog {
  color: @TextPrimary;
  background-color: @SurfaceBase;
  border: @BorderWidth solid transparent;
  border-radius: @CornerRadius; }

QGroupBox {
  color: @TextPrimary;
  border-top: 3px solid @BorderStrong; }
  QGroupBox::indicator {
    border: @BorderWidth solid @IndicatorBorder;
    background-color: @FieldBackground; }

QHeaderView::section {
  color: @TextPrimary;
  background-color: @ViewHeaderBackground;
  border-left: @BorderWidth solid @ViewHeaderBorder;
  border-right: @BorderWidth solid @ViewHeaderBorder; }

QHeaderView {
  background-color: @ViewHeaderBackground; }

QHeaderView::section:hover {
  background-color: @SurfaceHover; }

QHeaderView::section:pressed {
  color: @TextOnAccentSubtle;
  background-color: @AccentSubtle; }

QHeaderView::section:disabled {
  color: @TextDisabled; }

QHeaderView::section:pressed:disabled {
  color: @TextDisabled;
  background-color: @SurfaceDisabled; }

QTableCornerButton::section {
  background-color: @ViewHeaderBackground;
  border: @BorderWidth solid @ViewHeaderBorder; }

QLabel {
  color: @TextPrimary;
  background-color: transparent; }
  QLabel[haslink="true"] {
    color: @TextLink; }
  QLabel:disabled {
    color: @TextDisabled; }

QLineEdit {
  color: @TextPrimary;
  background-color: @FieldBackground;
  border: @BorderWidth solid @FieldBorder;
  border-radius: @CornerRadius; }
  QLineEdit:focus {
    border-color: @BorderFocus; }
  QLineEdit:disabled {
    color: @TextDisabled; }
  QLineEdit:hover {
    border: @BorderWidth solid @BorderHover; }
  QLineEdit:focus {
    border: @BorderWidth solid @BorderHover; }

QList, QListView, QTree, QTreeView {
  font-weight: 500;
  background-color: @FieldBackground;
  border-radius: @CornerRadius;
  border: @BorderWidth solid transparent; }
  QList::item, QListView::item, QTree::item, QTreeView::item {
    border-radius: @CornerRadius;
    border: @BorderWidth solid transparent; }
  QList::item:selected, QListView::item:selected, QTree::item:selected, QTreeView::item:selected {
    color: @TextOnAccent;
    background-color: @AccentStrong;
    border: @BorderWidth solid @BorderEmphasis; }
  QList::item:hover:!selected, QListView::item:hover:!selected, QTree::item:hover:!selected, QTreeView::item:hover:!selected {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle;
    border: @BorderWidth solid @AccentSubtleBorder;
    border-radius: @CornerRadius; }
  QList::indicator, QListView::indicator, QTree::indicator, QTreeView::indicator {
    background-color: transparent;
    border: @BorderWidth solid @IndicatorBorder;
    border-radius: @CornerRadius; }
    QList::indicator:disabled, QListView::indicator:disabled, QTree::indicator:disabled, QTreeView::indicator:disabled {
      border: @BorderWidth solid @BorderDisabled;
      border-radius: @CornerRadius; }

QListView {
  color: @TextPrimary;
  selection-color: @TextOnAccent;
  selection-background-color: @AccentStrong;
  background-color: @FieldBackground;
  alternate-background-color: @FieldBackground; }

QMainWindow::separator {
  border: 0px solid transparent;
  background-color: @BorderSubtle; }
  QMainWindow::separator:hover {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle; }

QMenu {
  background-color: @SurfaceOverlay;
  border: @BorderWidth solid @BorderSubtle;
  border-radius: @CornerRadius; }
  QMenu::item {
    background-color: @SurfaceOverlay;
    color: @TextPrimary;
    border: @BorderWidth solid transparent;
    border-radius: @CornerRadius;
    border-radius: 0px; }
  QMenu::item:disabled {
    color: @TextDisabled; }
  QMenu::item:selected {
    border: @BorderWidth solid @BorderHover;
    background-color: @SurfaceOverlayHover; }
  QMenu::item:pressed {
    color: @TextOnAccentSubtle;
    border: @BorderWidth solid @BorderHover;
    background-color: @AccentSubtle; }
  QMenu::indicator {
    border: @BorderWidth solid @IndicatorBorder; }
  QMenu::separator {
    background-color: @BorderSubtle; }

QMenuBar {
  color: @TextSecondary;
  background-color: @MenuBarBackground;
  border-bottom: @BorderWidth solid @BorderSubtle; }
  QMenuBar::item {
    border: @BorderWidth solid transparent;
    border-radius: @CornerRadius; }
  QMenuBar::item:pressed {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle;
    border: @BorderWidth solid @BorderHover; }
  QMenuBar::item:selected {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle;
    border: @BorderWidth solid @BorderHover; }

QProgressBar {
  color: @ProgressText;
  min-height: 24px;
  background-color: @ProgressBackground;
  text-align: center;
  border: @BorderWidth solid @BorderStrong; }
  QProgressBar::chunk {
    background-color: @ProgressChunk; }

QPushButton, QWidget#wbList QPushButton, QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton, #WbTabBar > QTabBar #ScrollLeftButton, #WbTabBar > QTabBar #ScrollRightButton {
  color: @TextPrimary;
  border: @BorderWidth solid @ControlBorder;
  background-color: @ControlBackground; }
  QPushButton:hover, QWidget#wbList QPushButton:hover, QSint--ActionGroup QFrame[class="content"] QToolButton:hover, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton:hover, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton:hover, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton:hover, #WbTabBar > QTabBar #ScrollLeftButton:hover, #WbTabBar > QTabBar #ScrollRightButton:hover {
    border: @BorderWidth solid @BorderHover;
    background-color: @ControlBackgroundHover; }
  QPushButton:focus, QWidget#wbList QPushButton:focus, QSint--ActionGroup QFrame[class="content"] QToolButton:focus, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton:focus, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton:focus, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton:focus, #WbTabBar > QTabBar #ScrollLeftButton:focus, #WbTabBar > QTabBar #ScrollRightButton:focus {
    border: @BorderWidth solid @BorderFocus;
    background-color: @ControlBackgroundHover; }
  QPushButton:disabled, QWidget#wbList QPushButton:disabled, QSint--ActionGroup QFrame[class="content"] QToolButton:disabled, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton:disabled, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton:disabled, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton:disabled, #WbTabBar > QTabBar #ScrollLeftButton:disabled, #WbTabBar > QTabBar #ScrollRightButton:disabled {
    color: @TextDisabled;
    background-color: @SurfaceDisabled; }
  QPushButton:pressed, QWidget#wbList QPushButton:pressed, QSint--ActionGroup QFrame[class="content"] QToolButton:pressed, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton:pressed, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton:pressed, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton:pressed, #WbTabBar > QTabBar #ScrollLeftButton:pressed, #WbTabBar > QTabBar #ScrollRightButton:pressed {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle; }
  QPushButton:default, QWidget#wbList QPushButton:default, QSint--ActionGroup QFrame[class="content"] QToolButton:default, QSint--ActionGroup QFrame[class="content"] QWidget#Selector > QToolButton:default, QWidget#wbList QSint--ActionGroup QFrame[class="content"] QToolButton:default, QSint--ActionGroup QFrame[class="content"] QWidget#wbList QToolButton:default, #WbTabBar > QTabBar #ScrollLeftButton:default, #WbTabBar > QTabBar #ScrollRightButton:default {
    border: @BorderWidth solid @BorderEmphasis; }

QRadioButton {
  color: @TextPrimary; }
  QRadioButton:disabled {
    color: @TextDisabled; }
  QRadioButton::indicator {
    margin: 2px;
    border: @BorderWidth solid @IndicatorBorder;
    background-color: @FieldBackground; }
    QRadioButton::indicator:focus {
      border-color: @BorderFocus; }
    QRadioButton::indicator:disabled {
      border-color: @BorderDisabled; }

QScrollBar {
  background-color: @ScrollbarTrack; }
  QScrollBar::handle {
    background-color: @ScrollbarHandle;
    border: @BorderWidth solid transparent; }
    QScrollBar::handle:hover {
      background-color: @ScrollbarHandleHover;
      border: @BorderWidth solid @BorderHover; }

QSizeGrip {
  background: transparent; }

QStatusBar {
  color: @TextSecondary; }

QTabBar::tab {
  color: @TextSecondary;
  background-color: transparent;
  border: @BorderWidth solid @BorderSubtle; }
  QTabBar::tab:hover {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle;
    border: @BorderWidth solid @AccentSubtleBorder; }
  QTabBar::tab:selected {
    color: @TextOnAccent;
    background-color: @AccentStrong;
    border: @BorderWidth solid @BorderEmphasis; }

QTabBar QToolButton, QTabBar QWidget#Selector > QToolButton {
  /* the scroll buttons are tool buttons */
  color: @TextPrimary;
  border: @BorderWidth solid @ControlBorder; }

QTableWidget, QTableView {
  background-color: @FieldBackground;
  alternate-background-color: @ViewAlternateRow;
  gridline-color: @ViewGridLines; }

QTableView {
  color: @TextPrimary;
  /*Text in focused cell*/
  selection-color: @TextOnAccent;
  selection-background-color: @AccentStrong; }
  QTableView:disabled {
    color: @TextDisabled; }
  QTableView::item:selected {
    color: @TextOnAccent;
    background-color: @AccentStrong; }
  QTableView::item:selected:disabled {
    color: @TextDisabled;
    background-color: @SurfaceDisabled; }
  QTableView::indicator {
    width: 12px;
    height: 12px;
    background-color: @FieldBackground;
    border: @BorderWidth solid @IndicatorBorder;
    border-radius: @CornerRadius; }
    QTableView::indicator:disabled {
      background-color: @SurfaceDisabled; }

QTreeView {
  background-color: @SurfaceBase;
  alternate-background-color: @SurfaceBase;
  border: @BorderWidth solid transparent;
  border-radius: @CornerRadius;
  selection-color: @TextOnAccent;
  selection-background-color: @AccentStrong; }
  QTreeView:enabled {
    color: @TextPrimary; }
  QTreeView:disabled {
    color: @TextDisabled; }
  QTreeView::item:selected {
    color: @TextOnAccent;
    background-color: @AccentStrong;
    border: @BorderWidth solid @BorderEmphasis; }

QTreeView::branch {
  background: transparent; }

QTextEdit, QPlainTextEdit {
  color: @TextPrimary;
  background-color: @FieldBackground;
  border: @BorderWidth solid @FieldBorder;
  border-radius: @CornerRadius; }
  QTextEdit:disabled, QPlainTextEdit:disabled {
    color: @TextDisabled;
    border-color: @BorderDisabled; }

QToolBar {
  background-color: @SurfaceBase;
  border-bottom: @BorderWidth solid @BorderSubtle; }
  QToolBar::separator {
    background-color: @BorderStrong; }

QToolBarExtension {
  border: @BorderWidth solid transparent;
  background-color: transparent; }

QToolButton, QWidget#Selector > QToolButton {
  border: @BorderWidth solid transparent;
  border-radius: @CornerRadius;
  color: @TextPrimary;
  background-color: transparent; }
  QToolButton:hover, QWidget#Selector > QToolButton:hover {
    background-color: @SurfaceHover;
    border: @BorderWidth solid @BorderHover; }
  QToolButton:focus, QWidget#Selector > QToolButton:focus {
    border: @BorderWidth solid @BorderFocus; }
  QToolButton:pressed, QWidget#Selector > QToolButton:pressed {
    color: @TextOnAccentSubtle;
    border: @BorderWidth solid @BorderHover;
    background-color: @AccentSubtle; }
  QToolButton:checked, QWidget#Selector > QToolButton:checked {
    color: @TextOnAccent;
    background-color: @AccentStrong;
    border: @BorderWidth solid @BorderHover; }
  QToolButton::menu-button, QWidget#Selector > QToolButton::menu-button {
    width: 14px;
    height: 14px;
    border-bottom: 0px solid #ffffff; }
  QToolButton::menu-arrow, QWidget#Selector > QToolButton::menu-arrow {
    background: transparent; }

QToolTip {
  color: @TooltipText;
  border: @BorderWidth solid @TooltipBorder;
  background-color: @TooltipBackground; }

QDialog QTreeWidget {
  color: @TextPrimary;
  background-color: @FieldBackground; }

QFileDialog {
  color: @TextPrimary; }

QWidget#wbList * {
  background-color: transparent; }

/*==================================================================================================
Tasks panel (custom FreeCAD class)
==================================================================================================*/
/* Action group */
QFrame[class="panel"] {
  background-color: transparent;
  /* temporal (transparent background) */ }

/* Panel header */
QSint--ActionGroup QFrame[class="header"] {
  border-bottom: 3px solid @BorderStrong;
  background-color: transparent; }

QSint--ActionGroup QFrame[class="header"]:hover {
  background-color: @ControlBackgroundHover;
  border-bottom: 3px solid @BorderHover; }

QSint--ActionGroup QToolButton[class="header"], QSint--ActionGroup QWidget#Selector > QToolButton[class="header"] {
  color: @TextPrimary;
  /* Task Panel Header text color */ }

QSint--ActionGroup QFrame[class="header"] QLabel {
  background-color: transparent; }

QSint--ActionGroup QFrame[class="header"] QLabel[fold="true"] {
  background-color: transparent; }

QSint--ActionGroup QFrame[class="content"] QTreeView QAbstractSpinBox, QSint--ActionGroup QFrame[class="content"] QTreeView QSpinBox {
  border: 0px solid transparent; }

Gui--PropertyEditor--PropertyEditor {
  gridline-color: @ViewGridLines;
  qproperty-groupBackground: @ViewGroupBackground;
  qproperty-groupTextColor: @TextPrimary; }

/* Cells with values that can only be changed with "..." button (Attachment)
/* These seem to draw on top of the underlying label, so must be completely hidden or have an opaque background */
Gui--PropertyEditor--PropertyEditor > QWidget > QWidget > QLabel {
  background-color: @SurfaceBase; }

Gui--OverlayToolButton {
  background-color: transparent;
  border: 0px solid transparent; }
  Gui--OverlayToolButton:hover {
    background-color: transparent;
    border: 0px solid transparent; }
  Gui--OverlayToolButton:pressed {
    background-color: transparent;
    border: 0px solid transparent; }

Gui--OverlayTitleBar {
  color: @TextSecondary; }

QSint--ActionGroup QFrame[class="content"] QDialog QToolButton, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton {
  border: @BorderWidth solid transparent;
  border-radius: @CornerRadius;
  color: @TextPrimary;
  background-color: transparent;
  padding: 2px; }
  QSint--ActionGroup QFrame[class="content"] QDialog QToolButton:hover, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton:hover {
    background-color: @SurfaceHover;
    border: @BorderWidth solid @BorderHover; }
  QSint--ActionGroup QFrame[class="content"] QDialog QToolButton:focus, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton:focus {
    border: @BorderWidth solid @BorderFocus; }
  QSint--ActionGroup QFrame[class="content"] QDialog QToolButton:pressed, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton:pressed {
    color: @TextOnAccentSubtle;
    border: @BorderWidth solid @BorderHover;
    background-color: @AccentSubtle; }
  QSint--ActionGroup QFrame[class="content"] QDialog QToolButton:checked, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton:checked {
    color: @TextOnAccent;
    background-color: @AccentStrong;
    border: @BorderWidth solid @BorderHover; }
  QSint--ActionGroup QFrame[class="content"] QDialog QToolButton:focus, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton:focus, QSint--ActionGroup QFrame[class="content"] QDialog QToolButton:disabled, QSint--ActionGroup QFrame[class="content"] QDialog QWidget#Selector > QToolButton:disabled {
    background-color: transparent; }

Gui--NotificationLabel {
  background-color: @SurfaceOverlay;
  border: @BorderWidth solid @BorderSubtle;
  border-radius: @CornerRadius; }

QTabWidget#TabBar > QTabBar {
  border: 0px solid transparent;
  background-color: transparent; }

QWidget#Tabs {
  background-color: transparent;
  border: 0px solid transparent; }

QWidget#Selector {
  border-bottom: @BorderWidth solid transparent; }

QWidget#Selector > QToolButton {
  font-weight: 500;
  background-color: @ControlBackground;
  border: @BorderWidth solid @ControlBorder;
  border-radius: @CornerRadiusLarge; }
  QWidget#Selector > QToolButton:hover {
    color: @TextOnAccentSubtle;
    background-color: @AccentSubtle;
    border: @BorderWidth solid @AccentSubtleBorder; }
  QWidget#Selector > QToolButton:selected {
    color: @TextOnAccent;
    background-color: @AccentStrong;
    border: @BorderWidth solid @BorderEmphasis; }

QDialog#Gui__Dialog__DlgPreferences QTreeView#groupsTreeView {
  selection-background-color: @AccentStrong; }
  QDialog#Gui__Dialog__DlgPreferences QTreeView#groupsTreeView::item:selected {
    background-color: @AccentStrong; }

QToolButton#ScrollLeftButton, QWidget#Selector > QToolButton#ScrollLeftButton,
QToolButton#ScrollRightButton,
QWidget#Selector > QToolButton#ScrollRightButton {
  background-color: @FieldBackground; }

QToolBox {
  background-color: transparent;
  color: @TextStrong; }

QToolBox::tab {
  color: @TextStrong; }

QToolBox::tab:disabled {
  color: @TextSecondary; }

QToolBox::tab:selected {
  color: @TextStrong; }

QToolBox::tab:selected:disabled {
  color: @TextSecondary; }

QToolBox::tab:!selected {
  color: @TextStrong; }
