# OpenLight: a theme definition for OpenTheme.
# One entry per line, written as  Name = colour  or  Name = expression.
# Lines starting with # are notes. tools/themes/README.md explains every entry.

description = A modern Light theme for FreeCAD based on the Open-Color palette
mode = light

# ---- Palette: this theme's own colour names. The leading 0 puts them first in FreeCAD's theme editor ----
0_SeedBackground = #dee1e4
0_SeedForeground = #000000
0_SeedAccent = #339af0
0_SeedOnAccent = #ffffff
0_SeedError = #c92a2a
0_SeedWarning = #e67700
0_SeedSuccess = #2b8a3e
0_SeedHighlight = #15aabf
0_SeedRecess = #ffffff
0_SeedExtreme = #000000
0_BorderWidth = 1px
0_CornerRadius = 2px
0_CornerRadiusLarge = 3px

# ---- Roles: where each colour is used ----
# Geometry
BorderWidth = 0_BorderWidth
CornerRadius = 0_CornerRadius
CornerRadiusLarge = 0_CornerRadiusLarge
# Text
TextPrimary = 0_SeedForeground
TextSecondary = blend(0_SeedBackground, 0_SeedForeground, 66)
TextDisabled = blend(0_SeedBackground, 0_SeedForeground, 37)
TextStrong = 0_SeedExtreme
TextLink = blend(0_SeedAccent, 0_SeedExtreme, 27)
# Surfaces
SurfaceBase = 0_SeedBackground
SurfaceOverlay = blend(0_SeedBackground, 0_SeedRecess, 58)
SurfaceOverlayHover = 0_SeedBackground
MenuBarBackground = blend(0_SeedBackground, 0_SeedRecess, 58)
SurfaceHover = blend(0_SeedBackground, 0_SeedForeground, 7)
SurfaceDisabled = blend(0_SeedBackground, 0_SeedRecess, 32)
# Inputs and controls
FieldBackground = blend(0_SeedBackground, 0_SeedRecess, 58)
FieldBorder = blend(0_SeedBackground, 0_SeedForeground, 26)
ControlBackground = blend(0_SeedBackground, 0_SeedForeground, 7)
ControlBackgroundHover = blend(0_SeedAccent, 0_SeedRecess, 57)
ControlBorder = blend(0_SeedBackground, 0_SeedForeground, 37)
IndicatorBorder = blend(0_SeedBackground, 0_SeedForeground, 37)
# Accent: Subtle is the hover tint, Strong the selected fill
AccentColor = blend(0_SeedAccent, 0_SeedExtreme, 11)
AccentSubtle = blend(0_SeedAccent, 0_SeedRecess, 57)
AccentSubtleBorder = blend(0_SeedAccent, 0_SeedExtreme, 11)
TextOnAccentSubtle = 0_SeedExtreme
AccentStrong = 0_SeedAccent
TextOnAccent = 0_SeedOnAccent
# Borders
BorderSubtle = blend(0_SeedBackground, 0_SeedForeground, 26)
BorderStrong = blend(0_SeedBackground, 0_SeedForeground, 37)
BorderDisabled = blend(0_SeedBackground, 0_SeedForeground, 26)
BorderHover = blend(0_SeedAccent, 0_SeedExtreme, 11)
BorderFocus = blend(0_SeedAccent, 0_SeedExtreme, 11)
BorderEmphasis = blend(0_SeedAccent, 0_SeedExtreme, 11)
# Item views
ViewAlternateRow = 0_SeedBackground
ViewGridLines = blend(0_SeedBackground, 0_SeedForeground, 37)
ViewHeaderBackground = blend(0_SeedBackground, 0_SeedForeground, 7)
ViewHeaderBorder = blend(0_SeedBackground, 0_SeedRecess, 58)
ViewGroupBackground = blend(0_SeedBackground, 0_SeedForeground, 7)
# Scrollbars, progress, tooltips
ScrollbarTrack = blend(0_SeedBackground, 0_SeedRecess, 58)
ScrollbarHandle = blend(0_SeedBackground, 0_SeedForeground, 37)
ScrollbarHandleHover = 0_SeedAccent
ProgressBackground = blend(0_SeedBackground, 0_SeedRecess, 58)
ProgressChunk = blend(0_SeedAccent, 0_SeedRecess, 14)
ProgressText = 0_SeedExtreme
TooltipBackground = blend(0_SeedAccent, 0_SeedRecess, 57)
TooltipText = 0_SeedExtreme
TooltipBorder = blend(0_SeedAccent, 0_SeedExtreme, 11)
# Overlay panels
OverlayHeaderBackground = 0_SeedBackground
OverlayGroupBackground = blend(0_SeedBackground, 0_SeedForeground, 26)
OverlayTitleBackground = blend(0_SeedBackground, 0_SeedForeground, 16)
# Status and 3D view (used by the .cfg and the stock Sketcher tokens, not by the stylesheet)
StatusError = 0_SeedError
StatusWarning = 0_SeedWarning
StatusSuccess = 0_SeedSuccess
ViewportHighlight = 0_SeedHighlight
ViewportSelection = blend(0_SeedHighlight, 0_SeedRecess, 12)
