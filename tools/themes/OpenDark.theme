# OpenDark: a theme definition for OpenTheme.
# One entry per line, written as  Name = colour  or  Name = expression.
# Lines starting with # are notes. tools/themes/README.md explains every entry.

description = A modern Dark theme for FreeCAD based on the Open-Color palette
mode = dark

# ---- Palette: this theme's own colour names. The leading 0 puts them first in FreeCAD's theme editor ----
0_SeedBackground = #222427
0_SeedForeground = #dee1e4
0_SeedAccent = #339af0
0_SeedOnAccent = #ffffff
0_SeedError = #ff8787
0_SeedWarning = #ffa94d
0_SeedSuccess = #69db7c
0_SeedHighlight = #15aabf
0_SeedRecess = #000000
0_SeedExtreme = #ffffff
0_BorderWidth = 1px
0_CornerRadius = 2px
0_CornerRadiusLarge = 3px

# ---- Roles: where each colour is used ----
# Geometry
BorderWidth = 0_BorderWidth
CornerRadius = 0_CornerRadius
CornerRadiusLarge = 0_CornerRadiusLarge
# Text
TextPrimary = 0_SeedForeground
TextSecondary = blend(0_SeedBackground, 0_SeedForeground, 75)
TextDisabled = blend(0_SeedBackground, 0_SeedForeground, 55)
TextStrong = blend(0_SeedForeground, 0_SeedExtreme, 78)
TextLink = blend(0_SeedAccent, 0_SeedExtreme, 33)
# Surfaces
SurfaceBase = 0_SeedBackground
SurfaceOverlay = blend(0_SeedBackground, 0_SeedRecess, 17)
SurfaceOverlayHover = 0_SeedBackground
MenuBarBackground = blend(0_SeedBackground, 0_SeedRecess, 17)
SurfaceHover = blend(0_SeedBackground, 0_SeedForeground, 22)
SurfaceDisabled = blend(0_SeedBackground, 0_SeedForeground, 5)
# Inputs and controls
FieldBackground = blend(0_SeedBackground, 0_SeedRecess, 17)
FieldBorder = blend(0_SeedBackground, 0_SeedForeground, 55)
ControlBackground = blend(0_SeedBackground, 0_SeedForeground, 22)
ControlBackgroundHover = blend(0_SeedBackground, 0_SeedForeground, 5)
ControlBorder = blend(0_SeedBackground, 0_SeedForeground, 55)
IndicatorBorder = blend(0_SeedBackground, 0_SeedForeground, 55)
# Accent: Subtle is the hover tint, Strong the selected fill
AccentColor = 0_SeedAccent
AccentSubtle = blend(0_SeedBackground, 0_SeedAccent, 19)
AccentSubtleBorder = blend(0_SeedAccent, 0_SeedRecess, 3)
TextOnAccentSubtle = blend(0_SeedForeground, 0_SeedExtreme, 78)
AccentStrong = 0_SeedAccent
TextOnAccent = 0_SeedOnAccent
# Borders
BorderSubtle = blend(0_SeedBackground, 0_SeedForeground, 5)
BorderStrong = blend(0_SeedBackground, 0_SeedForeground, 22)
BorderDisabled = blend(0_SeedBackground, 0_SeedForeground, 5)
BorderHover = blend(0_SeedAccent, 0_SeedRecess, 3)
BorderFocus = blend(0_SeedAccent, 0_SeedRecess, 3)
BorderEmphasis = 0_SeedAccent
# Item views
ViewAlternateRow = 0_SeedBackground
ViewGridLines = blend(0_SeedBackground, 0_SeedForeground, 22)
ViewHeaderBackground = blend(0_SeedBackground, 0_SeedForeground, 5)
ViewHeaderBorder = blend(0_SeedBackground, 0_SeedRecess, 17)
ViewGroupBackground = blend(0_SeedBackground, 0_SeedForeground, 22)
# Scrollbars, progress, tooltips
ScrollbarTrack = blend(0_SeedBackground, 0_SeedRecess, 17)
ScrollbarHandle = blend(0_SeedBackground, 0_SeedForeground, 55)
ScrollbarHandleHover = 0_SeedAccent
ProgressBackground = blend(0_SeedBackground, 0_SeedRecess, 17)
ProgressChunk = blend(0_SeedAccent, 0_SeedRecess, 18)
ProgressText = blend(0_SeedForeground, 0_SeedExtreme, 78)
TooltipBackground = blend(0_SeedAccent, 0_SeedRecess, 11)
TooltipText = blend(0_SeedForeground, 0_SeedExtreme, 78)
TooltipBorder = blend(0_SeedBackground, 0_SeedAccent, 33)
# Overlay panels
OverlayHeaderBackground = blend(0_SeedBackground, 0_SeedForeground, 5)
OverlayGroupBackground = blend(0_SeedBackground, 0_SeedForeground, 5)
OverlayTitleBackground = 0_SeedBackground
# Status and 3D view (used by the .cfg and the stock Sketcher tokens, not by the stylesheet)
StatusError = 0_SeedError
StatusWarning = 0_SeedWarning
StatusSuccess = 0_SeedSuccess
ViewportHighlight = 0_SeedHighlight
ViewportSelection = blend(0_SeedHighlight, 0_SeedExtreme, 12)
